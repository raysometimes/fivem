 #ifndef ARRAYSIZE
     #define ARRAYSIZE(A) (sizeof(A)/sizeof((A)[0]))
 #endif
 
+static HANDLE g_cfxEarlyRawTraceFile = INVALID_HANDLE_VALUE;
+
+DWORD CfxEarlyRawTraceOpen(void)
+{
+    DWORD savedLastError = GetLastError();
+    DWORD result = ERROR_SUCCESS;
+    static const WCHAR suffix[] = L".minhook-freeze.bin";
+    WCHAR tracePath[MAX_PATH + 32];
+    DWORD pathLength;
+    DWORD suffixLength;
+    DWORD i;
+
+    if (g_cfxEarlyRawTraceFile != INVALID_HANDLE_VALUE)
+        goto exit;
+
+    pathLength = GetModuleFileNameW(
+        NULL,
+        tracePath,
+        (DWORD)ARRAYSIZE(tracePath));
+
+    if (pathLength == 0)
+    {
+        result = GetLastError();
+        if (result == ERROR_SUCCESS)
+            result = ERROR_GEN_FAILURE;
+        goto exit;
+    }
+
+    suffixLength = (DWORD)ARRAYSIZE(suffix);
+    if (pathLength + suffixLength > (DWORD)ARRAYSIZE(tracePath))
+    {
+        result = ERROR_BUFFER_OVERFLOW;
+        goto exit;
+    }
+
+    /*
+     * Manual copy: do not introduce memcpy or any other CRT operation into
+     * the raw tracer implementation.
+     */
+    for (i = 0; i < suffixLength; ++i)
+        tracePath[pathLength + i] = suffix[i];
+
+    g_cfxEarlyRawTraceFile = CreateFileW(
+        tracePath,
+        GENERIC_WRITE,
+        FILE_SHARE_READ,
+        NULL,
+        CREATE_ALWAYS,
+        FILE_ATTRIBUTE_NORMAL,
+        NULL);
+
+    if (g_cfxEarlyRawTraceFile == INVALID_HANDLE_VALUE)
+        result = GetLastError();
+
+exit:
+    SetLastError(savedLastError);
+    return result;
+}
+
+VOID CfxEarlyRawTraceClose(void)
+{
+    DWORD savedLastError = GetLastError();
+
+    if (g_cfxEarlyRawTraceFile != INVALID_HANDLE_VALUE)
+    {
+        HANDLE file = g_cfxEarlyRawTraceFile;
+        g_cfxEarlyRawTraceFile = INVALID_HANDLE_VALUE;
+        CloseHandle(file);
+    }
+
+    SetLastError(savedLastError);
+}
+
+VOID CfxEarlyRawTraceWrite(
+    uint32_t marker,
+    uint64_t value1,
+    uint64_t value2,
+    uint32_t lastError)
+{
+    DWORD savedLastError = GetLastError();
+
+    if (g_cfxEarlyRawTraceFile != INVALID_HANDLE_VALUE)
+    {
+        CfxEarlyRawTraceRecord record;
+        DWORD written;
+
+        record.marker = marker;
+        record.processId = GetCurrentProcessId();
+        record.threadId = GetCurrentThreadId();
+        record.value1 = value1;
+        record.value2 = value2;
+        record.lastError = lastError;
+
+        WriteFile(
+            g_cfxEarlyRawTraceFile,
+            &record,
+            (DWORD)sizeof(record),
+            &written,
+            NULL);
+    }
+
+    SetLastError(savedLastError);
+}
